---
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import LanguageSwitch from '@/components/ui/LanguageSwitch.astro';
import Logo from '@/components/ui/Logo.astro';
import { type Lang, useTranslations } from '@/i18n/ui';
import { primaryNav, sectionHref, sectionIds } from '@/lib/navigation';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="site-header">
  <div class="site-header__ribbon" aria-hidden="true"></div>
  <div class="site-header__bar">
    <a class="brand" href={sectionHref(sectionIds.hero, lang)}>
      <Logo size={52} />
      <span class="brand__text">
        <span class="brand__name">{t('site.name')}</span>
        <span class="brand__tagline">{t('site.tagline')}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label={t('nav.primary')}>
      <!-- On small screens the menu opens as a popover; on wide screens it is shown inline. -->
      <button class="site-nav__toggle" type="button" popovertarget="site-menu">
        <Icon name="menu" size={22} />
        <span class="sr-only">{t('nav.openMenu')}</span>
      </button>
      <ul id="site-menu" class="site-nav__menu" popover>
        {primaryNav.map((item) => (
          <li>
            <a href={sectionHref(item.id, lang)}>{t(item.label)}</a>
          </li>
        ))}
        <li class="site-nav__lang">
          <LanguageSwitch lang={lang} />
        </li>
      </ul>
    </nav>

    <div class="site-header__actions">
      <div class="site-header__lang">
        <LanguageSwitch lang={lang} />
      </div>
      <Button href={sectionHref(sectionIds.donate, lang)} tone="amber">
        {t('cta.donate')}
      </Button>
    </div>
  </div>
</header>

<script>
  // Close the small-screen menu after a link in it is chosen.
  const menu = document.getElementById('site-menu');
  menu?.addEventListener('click', (event) => {
    if (
      event.target instanceof Element &&
      event.target.closest('a') &&
      menu.matches(':popover-open')
    ) {
      menu.hidePopover();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    block-size: var(--header-height);
    background: var(--color-ivory);
    border-block-end: 1px solid color-mix(in srgb, var(--color-gold) 45%, transparent);
  }

  .site-header__ribbon {
    block-size: var(--ribbon-height);
    background: url('../../assets/images/glass-strip.jpg') center / cover;
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    block-size: calc(var(--header-height) - var(--ribbon-height));
    max-inline-size: 81rem;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-navy);
    text-decoration: none;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    line-height: 1;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6875rem;
  }

  .brand__tagline {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .site-nav__menu {
    list-style: none;
    padding: 0;
    font-size: 1.125rem;
    font-weight: 500;
  }

  .site-nav__menu a {
    display: block;
    padding-block: var(--space-2);
    color: var(--color-navy);
    text-decoration: none;
  }

  .site-nav__menu a:hover {
    color: var(--color-gold-text);
  }

  .site-nav__toggle {
    display: none;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 1px solid var(--color-gold);
    border-radius: 50%;
    background: transparent;
    color: var(--color-navy);
    cursor: pointer;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  /* The language switch sits in the header on wide screens and in the menu on small ones. */
  .site-nav__lang {
    display: none;
  }

  /* Wide screens: the menu is a plain inline list. These rules override the popover defaults. */
  @media (min-width: 60rem) {
    .site-nav__menu {
      position: static;
      display: flex;
      gap: var(--space-6);
      inset: auto;
      margin: 0;
      border: 0;
      background: none;
      overflow: visible;
    }
  }

  /* Small screens: a menu button opens the list as a panel under the header. */
  @media (max-width: 59.99rem) {
    .site-header__bar {
      gap: var(--space-3);
    }

    .brand {
      gap: var(--space-2);
    }

    .brand :global(.logo) {
      inline-size: 2.5rem;
      block-size: 2.5rem;
    }

    .site-nav {
      order: 3;
    }

    .site-nav__toggle {
      display: grid;
    }

    .site-nav__menu {
      inset: var(--header-height) 0 auto;
      inline-size: auto;
      margin: 0;
      padding: var(--space-4) var(--gutter) var(--space-6);
      border: 0;
      border-block-end: 1px solid var(--color-gold);
      background: var(--color-ivory);
      box-shadow: 0 1.5rem 2rem -1.5rem rgb(10 26 60 / 0.35);
      font-size: 1.375rem;
    }

    .site-nav__menu a {
      padding-block: var(--space-3);
    }

    .site-nav__lang {
      display: block;
      padding-block-start: var(--space-4);
    }

    .site-nav__lang :global(a) {
      padding-block: 0;
    }

    .site-header__lang {
      display: none;
    }

    .brand__tagline {
      display: none;
    }

    .brand__name {
      font-size: 1.375rem;
      white-space: nowrap;
    }

    /* The English name is longer, and the Latin fallback face is wider than Kehila Serif. */
    .brand__name:lang(en) {
      font-size: 1.125rem;
    }

    .site-header__actions {
      margin-inline-start: auto;
    }

    .site-header__actions {
      gap: var(--space-2);
    }

    .site-header__actions :global(.button--plaque) {
      min-block-size: 2.75rem;
      padding-inline: 1.375rem;
      font-size: 1.0625rem;
    }
  }

  /* The narrowest phones (360px and below) */
  @media (max-width: 24rem) {
    .brand__name {
      font-size: 1.1875rem;
    }

    .brand__name:lang(en) {
      font-size: 1rem;
    }

    .site-header__actions :global(.button--plaque) {
      padding-inline: 1.125rem;
    }
  }

  @media (max-width: 21.25rem) {
    .site-header__bar {
      gap: var(--space-2);
      padding-inline: var(--space-3);
    }

    .brand__name {
      font-size: 1rem;
    }

    .brand__name:lang(en) {
      font-size: 0.875rem;
    }
  }
</style>
