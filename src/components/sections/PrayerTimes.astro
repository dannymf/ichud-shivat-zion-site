---
import Section from '@/components/layout/Section.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import ScheduleCard from '@/components/ui/ScheduleCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { type Lang, useTranslations } from '@/i18n/ui';
import { sectionContent } from '@/lib/home-content';
import { getWeekInfo } from '@/lib/jewish-calendar';
import { sectionIds } from '@/lib/navigation';
import { linkOr, siteSettings } from '@/lib/settings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prayerTimes = sectionContent('prayerTimes', lang);
const site = siteSettings(lang);
const week = getWeekInfo(new Date(), {
  candleLightingMinutes: prayerTimes.candleLightingMinutes,
  lang,
});
const facts = [
  { label: t('prayerTimes.today'), value: `${week.today.weekday} · ${week.today.hebrewDate}` },
  { label: t('prayerTimes.candleLighting'), value: week.shabbat.candleLighting, isTime: true },
  { label: t('prayerTimes.havdalah'), value: week.shabbat.havdalah, isTime: true },
].filter((fact) => fact.value !== undefined);
---

<Section id={sectionIds.prayerTimes} tone="navy" headingId="prayer-times-title">
  <div class="prayer-times">
    <SectionHeading
      id="prayer-times-title"
      eyebrow={week.shabbat.title && `${t('prayerTimes.weekOf')} ${week.shabbat.title}`}
      title={prayerTimes.title}
      align="center"
      on="dark"
    />

    <dl class="week">
      {facts.map((fact) => (
        <div class="week__fact">
          <dt>{fact.label}</dt>
          <dd class:list={{ week__time: fact.isTime }}>
            {fact.isTime ? (
              <time datetime={fact.value} dir="ltr">
                {fact.value}
              </time>
            ) : (
              fact.value
            )}
          </dd>
        </div>
      ))}
    </dl>

    <div class="prayer-times__cards">
      <ScheduleCard
        title={prayerTimes.weekdays.title}
        subtitle={prayerTimes.weekdays.subtitle}
        rows={prayerTimes.weekdays.rows}
      />
      <ScheduleCard
        title={prayerTimes.shabbat.title}
        subtitle={week.shabbat.title}
        rows={prayerTimes.shabbat.rows}
      />
    </div>

    <Button href={linkOr(site.links.prayerSchedule)} variant="link" tone="ivory">
      <Icon name="download" />
      {prayerTimes.fullScheduleCta}
    </Button>
  </div>
</Section>

<style>
  .prayer-times {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-7);
    max-inline-size: 70rem;
    margin-inline: auto;
  }

  /* Today / candle lighting / havdalah strip */
  .week {
    align-self: stretch;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    border: 1px solid color-mix(in srgb, var(--color-gold-light) 55%, transparent);
    border-radius: var(--radius-md);
  }

  .week__fact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-5);
    text-align: center;
  }

  .week__fact + .week__fact {
    border-inline-start: 1px solid color-mix(in srgb, var(--color-gold-light) 55%, transparent);
  }

  .week dt {
    font-size: var(--text-sm);
    color: var(--color-gold-light);
  }

  .week dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.625rem;
    line-height: 1.3;
  }

  .week dd.week__time {
    font-family: var(--font-body);
    font-size: 1.875rem;
    line-height: 1.15;
  }

  .prayer-times__cards {
    align-self: stretch;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(27.5rem, 100%), 1fr));
    gap: var(--space-5);
  }

  @media (max-width: 47.99rem) {
    .week__fact + .week__fact {
      border-inline-start: 0;
      border-block-start: 1px solid color-mix(in srgb, var(--color-gold-light) 55%, transparent);
    }
  }
</style>
