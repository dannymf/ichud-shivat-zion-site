---
import Section from '@/components/layout/Section.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import ScheduleCard from '@/components/ui/ScheduleCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { type Lang, useTranslations } from '@/i18n/ui';
import { sectionContent } from '@/lib/home-content';
import { getWeekInfo } from '@/lib/jewish-calendar';
import { sectionIds } from '@/lib/navigation';
import { linkOr, siteSettings } from '@/lib/settings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prayerTimes = sectionContent('prayerTimes', lang);
const site = siteSettings(lang);
const week = getWeekInfo(new Date(), {
  candleLightingMinutes: prayerTimes.candleLightingMinutes,
  lang,
});
const facts = [
  { label: t('prayerTimes.today'), value: `${week.today.weekday} · ${week.today.hebrewDate}` },
  { label: t('prayerTimes.candleLighting'), value: week.shabbat.candleLighting, isTime: true },
  { label: t('prayerTimes.havdalah'), value: week.shabbat.havdalah, isTime: true },
].filter((fact) => fact.value !== undefined);
---

<Section id={sectionIds.prayerTimes} tone="navy" headingId="prayer-times-title" density="compact">
  <div class="prayer-times">
    <!-- No eyebrow: the Shabbat card already names the parasha, and the section has to fit on one screen. -->
    <SectionHeading id="prayer-times-title" title={prayerTimes.title} align="center" on="dark" />

    <dl class="week">
      {facts.map((fact) => (
        <div class="week__fact">
          <dt>{fact.label}</dt>
          <dd class:list={{ week__time: fact.isTime }}>
            {fact.isTime ? (
              <time datetime={fact.value} dir="ltr">
                {fact.value}
              </time>
            ) : (
              fact.value
            )}
          </dd>
        </div>
      ))}
    </dl>

    <!-- Focusable so the row can be scrolled with the keyboard where it scrolls (phones). -->
    <div
      class="prayer-times__cards"
      role="group"
      aria-label={t('prayerTimes.schedules')}
      tabindex="0"
    >
      <ScheduleCard
        title={prayerTimes.weekdays.title}
        subtitle={prayerTimes.weekdays.subtitle}
        rows={prayerTimes.weekdays.rows}
        density="compact"
      />
      <ScheduleCard
        title={prayerTimes.shabbat.title}
        subtitle={week.shabbat.title}
        rows={prayerTimes.shabbat.rows}
        density="compact"
      />
    </div>

    <Button href={linkOr(site.links.prayerSchedule)} variant="link" tone="ivory">
      <Icon name="download" />
      {prayerTimes.fullScheduleCta}
    </Button>
  </div>
</Section>

<style>
  .prayer-times {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    max-inline-size: 70rem;
    margin-inline: auto;
  }

  /* Today / candle lighting / havdalah strip */
  .week {
    align-self: stretch;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    border: 1px solid color-mix(in srgb, var(--color-gold-light) 55%, transparent);
    border-radius: var(--radius-md);
  }

  .week__fact {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    text-align: center;
  }

  .week__fact + .week__fact {
    border-inline-start: 1px solid color-mix(in srgb, var(--color-gold-light) 55%, transparent);
  }

  .week dt {
    font-size: var(--text-sm);
    color: var(--color-gold-light);
  }

  .week dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.3;
  }

  .week dd.week__time {
    font-family: var(--font-body);
    font-size: 1.625rem;
    line-height: 1.15;
  }

  .prayer-times__cards {
    align-self: stretch;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(27.5rem, 100%), 1fr));
    gap: var(--space-5);
  }

  /*
   * Phones: today's date across the top of the strip with the two Shabbat times under it, and the
   * two timetables side by side in a row you swipe, the next card peeking in, so the section still
   * fits on one screen.
   */
  @media (max-width: 47.99rem) {
    .prayer-times {
      gap: var(--space-4);
    }

    .week {
      grid-template-columns: 1fr 1fr;
    }

    .week__fact {
      padding: var(--space-2) var(--space-3);
    }

    .week__fact:first-child {
      grid-column: 1 / -1;
      border-block-end: 1px solid color-mix(in srgb, var(--color-gold-light) 55%, transparent);
    }

    /* Needs the extra selector to outrank the divider rule above once Astro scopes both. */
    .week__fact + .week__fact:nth-child(2) {
      border-inline-start: 0;
    }

    .week dt {
      font-size: 0.9375rem;
    }

    .week dd {
      font-size: 1.1875rem;
    }

    .week dd.week__time {
      font-size: 1.375rem;
    }

    .prayer-times__cards {
      grid-template-columns: none;
      grid-auto-flow: column;
      /* Wide enough for long English labels, leaving the next card peeking in. */
      grid-auto-columns: calc(100% - 2.75rem);
      gap: var(--space-3);
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .prayer-times__cards > :global(*) {
      scroll-snap-align: start;
    }
  }
</style>
