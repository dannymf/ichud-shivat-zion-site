---
import Section from '@/components/layout/Section.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import ScheduleCard from '@/components/ui/ScheduleCard.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { type Lang, useTranslations } from '@/i18n/ui';
import { sectionContent } from '@/lib/home-content';
import { sectionIds } from '@/lib/navigation';
import { linkOr, siteSettings } from '@/lib/settings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const prayerTimes = sectionContent('prayerTimes', lang);
const site = siteSettings(lang);
// The date and Shabbat times depend on the day the page is opened, so they are filled in by the
// script at the bottom of this file rather than at build time.
const facts = [
  { name: 'today', label: t('prayerTimes.today'), isTime: false },
  { name: 'candleLighting', label: t('prayerTimes.candleLighting'), isTime: true },
  { name: 'havdalah', label: t('prayerTimes.havdalah'), isTime: true },
];
---

<Section id={sectionIds.prayerTimes} tone="navy" headingId="prayer-times-title" density="compact">
  <div
    class="prayer-times"
    data-week
    data-lang={lang}
    data-candle-lighting-minutes={prayerTimes.candleLightingMinutes}
  >
    <!-- No eyebrow: the Shabbat card already names the parasha, and the section has to fit on one screen. -->
    <SectionHeading id="prayer-times-title" title={prayerTimes.title} align="center" on="dark" />

    <dl class="week">
      {facts.map((fact) => (
        <div class="week__fact" data-fact={fact.name}>
          <dt>{fact.label}</dt>
          <dd class:list={{ week__time: fact.isTime }}>
            {fact.isTime ? <time dir="ltr" data-value /> : <span data-value />}
          </dd>
        </div>
      ))}
    </dl>
    <noscript>
      <style is:inline>
        .prayer-times .week {
          display: none !important;
        }
      </style>
    </noscript>

    <!-- Focusable so the row can be scrolled with the keyboard where it scrolls (phones). -->
    <div
      class="prayer-times__cards"
      role="group"
      aria-label={t('prayerTimes.schedules')}
      tabindex="0"
    >
      <ScheduleCard
        title={prayerTimes.weekdays.title}
        subtitle={prayerTimes.weekdays.subtitle}
        rows={prayerTimes.weekdays.rows}
        density="compact"
      />
      <ScheduleCard
        title={prayerTimes.shabbat.title}
        rows={prayerTimes.shabbat.rows}
        density="compact"
      >
        <span slot="subtitle" data-parasha></span>
      </ScheduleCard>
    </div>

    <Button href={linkOr(site.links.prayerSchedule)} variant="link" tone="ivory">
      <Icon name="download" />
      {prayerTimes.fullScheduleCta}
    </Button>
  </div>
</Section>

<style>
  .prayer-times {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    max-inline-size: 70rem;
    margin-inline: auto;
  }

  /* Today / candle lighting / havdalah strip */
  .week {
    align-self: stretch;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    border: 1px solid color-mix(in srgb, var(--color-gold-light) 55%, transparent);
    border-radius: var(--radius-md);
  }

  /* Hold the strip's space until the script has filled it in, so the page doesn't jump. */
  .prayer-times:not([data-ready]) .week {
    visibility: hidden;
  }

  .week__fact {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    text-align: center;
  }

  .week__fact[hidden] {
    display: none;
  }

  .week__fact + .week__fact {
    border-inline-start: 1px solid color-mix(in srgb, var(--color-gold-light) 55%, transparent);
  }

  .week dt {
    font-size: var(--text-sm);
    color: var(--color-gold-light);
  }

  .week dd {
    margin: 0;
    min-block-size: 1lh;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.3;
  }

  .week dd.week__time {
    font-family: var(--font-body);
    font-size: 1.625rem;
    line-height: 1.15;
  }

  .prayer-times__cards {
    align-self: stretch;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(27.5rem, 100%), 1fr));
    gap: var(--space-5);
  }

  /*
   * Phones: today's date across the top of the strip with the two Shabbat times under it, and the
   * two timetables side by side in a row you swipe, the next card peeking in, so the section still
   * fits on one screen.
   */
  @media (max-width: 47.99rem) {
    .prayer-times {
      gap: var(--space-4);
    }

    .week {
      grid-template-columns: 1fr 1fr;
    }

    .week__fact {
      padding: var(--space-2) var(--space-3);
    }

    .week__fact:first-child {
      grid-column: 1 / -1;
      border-block-end: 1px solid color-mix(in srgb, var(--color-gold-light) 55%, transparent);
    }

    /* Needs the extra selector to outrank the divider rule above once Astro scopes both. */
    .week__fact + .week__fact:nth-child(2) {
      border-inline-start: 0;
    }

    .week dt {
      font-size: 0.9375rem;
    }

    .week dd {
      font-size: 1.1875rem;
    }

    .week dd.week__time {
      font-size: 1.375rem;
    }

    .prayer-times__cards {
      grid-template-columns: none;
      grid-auto-flow: column;
      /* Wide enough for long English labels, leaving the next card peeking in. */
      grid-auto-columns: calc(100% - 2.75rem);
      gap: var(--space-3);
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .prayer-times__cards > :global(*) {
      scroll-snap-align: start;
    }
  }
</style>

<script>
  import type { Lang } from '@/i18n/ui';
  import type { WeekInfo } from '@/lib/jewish-calendar';

  const root = document.querySelector<HTMLElement>('[data-week]');

  if (root) {
    const lang: Lang = root.dataset.lang === 'en' ? 'en' : 'he';
    const candleLightingMinutes = Number(root.dataset.candleLightingMinutes);

    // A missing value hides its fact (e.g. no candle lighting when Shabbat has no Friday evening).
    const setFact = (name: string, value: string | undefined) => {
      const fact = root.querySelector<HTMLElement>(`[data-fact="${name}"]`);
      const target = fact?.querySelector<HTMLElement>('[data-value]');
      if (!fact || !target) return;
      fact.hidden = value === undefined;
      target.textContent = value ?? '';
      if (target instanceof HTMLTimeElement && value) target.dateTime = value;
    };

    const render = (week: WeekInfo) => {
      setFact('today', `${week.today.weekday} · ${week.today.hebrewDate}`);
      setFact('candleLighting', week.shabbat.candleLighting);
      setFact('havdalah', week.shabbat.havdalah);
      const parasha = root.querySelector('[data-parasha]');
      if (parasha) parasha.textContent = week.shabbat.title ?? '';
      root.dataset.ready = '';
    };

    const start = async () => {
      // Hebcal is about 60 kB gzipped and the section is below the fold, so it loads when idle.
      const { getWeekInfo } = await import('@/lib/jewish-calendar');
      const refresh = () => render(getWeekInfo(new Date(), { candleLightingMinutes, lang }));
      refresh();

      // A tab left open overnight, or restored from the back/forward cache, still shows the old day.
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden) refresh();
      });
      window.addEventListener('pageshow', (event) => {
        if (event.persisted) refresh();
      });
    };

    const startSafely = () =>
      void start().catch((error: unknown) =>
        console.error('Could not load the Hebrew calendar', error),
      );

    if ('requestIdleCallback' in window) requestIdleCallback(startSafely);
    else setTimeout(startSafely, 200);
  }
</script>
