---
import Diamond from './Diamond.astro';

/** The gold rule with a stained-glass diamond, used under section headings. */
interface Props {
  align?: 'start' | 'center';
  /** `dark` for use on navy or blue backgrounds. */
  on?: 'light' | 'dark';
}

const { align = 'center', on = 'light' } = Astro.props;
---

<div class:list={['divider', `divider--${align}`, `divider--on-${on}`]} aria-hidden="true">
  <span class="divider__rule"></span>
  <Diamond />
  <span class="divider__rule"></span>
</div>

<style>
  .divider {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .divider--center {
    justify-content: center;
  }

  .divider__rule {
    inline-size: 4.5rem;
    block-size: 1px;
    background: var(--color-gold);
  }

  .divider--on-dark .divider__rule {
    background: var(--color-gold-light);
  }
</style>
