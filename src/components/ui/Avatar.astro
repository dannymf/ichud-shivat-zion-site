---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/**
 * A round portrait: the person's photo when there is one, otherwise their initial
 * on a coloured circle. Decorative; the person's name is always shown next to it.
 * `size` sets the default diameter; a parent can override it with `inline-size` and `block-size`.
 */
interface Props {
  name: string;
  color: 'cobalt' | 'forest' | 'orange' | 'teal' | 'red';
  photo?: ImageMetadata;
  /** Diameter in px */
  size?: number;
}

const { name, color, photo, size = 146 } = Astro.props;
// The first letter of the name, skipping a title such as "הרב" or "Rabbi".
const letter = name.replace(/^(הרב|Rabbi|Rav)\s+/, '').charAt(0);
---

{photo ? (
  <Image
    class="avatar"
    src={photo}
    alt=""
    width={size}
    height={size}
    densities={[1, 2]}
    style={`--size: ${size}px`}
  />
) : (
  <span
    class="avatar avatar--monogram"
    style={`--size: ${size}px; --bg: var(--monogram-${color})`}
    aria-hidden="true"
  >
    <span class="avatar__letter">{letter}</span>
  </span>
)}

<style>
  .avatar {
    flex: none;
    inline-size: var(--size);
    block-size: var(--size);
    border-radius: 50%;
    object-fit: cover;
  }

  /* The letter scales with the circle, so callers can resize the avatar with CSS alone. */
  .avatar--monogram {
    display: grid;
    place-items: center;
    container-type: inline-size;
    background: var(--bg);
    color: var(--color-ivory);
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1;
  }

  .avatar__letter {
    font-size: 40cqi;
  }
</style>
