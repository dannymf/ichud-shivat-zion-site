---
/**
 * The community mark: a menorah forming the letters א-ש-צ inside a circle.
 * Drawn with `currentColor`, so set `color` on the logo or a parent to recolour it.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 56, class: className } = Astro.props;
---

<svg
  class:list={['logo', className]}
  viewBox="0 0 120 120"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="square"
  aria-hidden="true"
>
  <circle cx="60" cy="60" r="55"></circle>
  <path d="M60 29.5V100 M51.3 29.5V53.8H68.7V29.5 M31.6 48.6V66.6H88.4V48.6 M20.3 48.6V79.1H99.7V48.6"></path>
  <path d="M53.5 101.5H66.5L64 97.5H56Z" fill="currentColor" stroke-width="1"></path>
  <path
    d="M90.5 33L100.5 43.5 M100.2 32.8C100.2 36 98.6 37.6 96.6 39.4 M94.4 37.1C92.2 38.6 91 40.6 91 43.6"
    stroke-linecap="round"
  ></path>
  <path d="M24.3 32L32 42.6 M33.5 31.6L29.6 38.8 M22.6 42.8H33.4" stroke-linecap="round"></path>
</svg>

<style>
  .logo {
    flex: none;
  }
</style>
