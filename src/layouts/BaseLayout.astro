---
import { Font, getImage } from 'astro:assets';
import shareImage from '@/assets/images/exterior.jpg';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import { defaultLang, type Lang, textDirection, useTranslations } from '@/i18n/ui';
import { site } from '@/lib/settings';
import '@/styles/global.css';

interface Props {
  lang?: Lang;
  /** Page title; the site name is appended. Leave out on the home page. */
  title?: string;
  description?: string;
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const { lang = defaultLang, title, description, noindex = false } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} · ${t('site.name')}` : t('site.name');
const pageDescription = description ?? t('site.description');

// Absolute URLs (canonical link, share image) need `site` in astro.config.mjs; until the domain is
// chosen they are left out rather than guessed.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site
  ? new URL((await getImage({ src: shareImage, width: 1200, format: 'jpg' })).src, Astro.site).href
  : undefined;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Synagogue',
  name: t('site.name'),
  description: t('site.description'),
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressCountry: 'IL',
  },
  ...(canonical && { url: canonical }),
};
---

<!doctype html>
<html lang={lang} dir={textDirection[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f7f1e4" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {!noindex && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    )}

    <Font cssVariable="--font-kehila" preload />
    <Font cssVariable="--font-frank-ruhl" preload />
    <Font cssVariable="--font-aviv" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('a11y.skipToContent')}
    </a>
    <SiteHeader lang={lang} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-4);
    inset-block-start: var(--space-4);
    z-index: 20;
    padding: var(--space-2) var(--space-4);
    background: var(--color-navy);
    color: var(--color-ivory);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
